# Copy to .env (or set these in your host's dashboard) before going live.

SITE_NAME=AK YouTube Downloader
# No trailing slash. Used for canonical URLs, sitemap.xml and Open Graph tags.
SITE_URL=https://your-domain.com
CONTACT_EMAIL=support@your-domain.com

# Server behaviour
HOST=0.0.0.0
PORT=8000
NO_BROWSER=1
MAX_WORKERS=2

# Delete prepared files after this many minutes (0 = never, use 15-60 in production)
RETENTION_MINUTES=30

# Optional: route YouTube requests through a proxy if the host's IP gets rate limited.
# Supported schemes: http, https, socks5, socks5h. Include credentials if the
# provider gives you a username and password.
# PROXY=http://username:password@gate.provider.com:7000
# PROXY=socks5h://username:password@127.0.0.1:1080

# Optional global speed cap, e.g. 5M for 5 MB/s
# RATE_LIMIT=

# Path to a cookies.txt exported from a browser signed in to YouTube (throwaway account).
# This is the main fix for "YouTube is blocking this server (bot check)".
# On Render, add it as a Secret File and use the path below.
# COOKIES_FILE=/etc/secrets/cookies.txt

# Order of YouTube player clients to try when one is blocked
# YTDLP_PLAYER_CLIENTS=default,android_vr,web_safari,tv,mweb

# PO token provider (bgutil). Needed for web/mweb/android clients on flagged IPs.
#   docker run -d --init -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider
# POT_BASE_URL=http://127.0.0.1:4416

# Set to a random string to enable /api/diagnose?key=...&url=... , then unset it again.
# DEBUG_KEY=
